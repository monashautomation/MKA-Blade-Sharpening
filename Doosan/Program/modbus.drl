# Rotation function
def rotate_tcp(tcp, pivot, transformation):
    # pivot: [px, py, pz] offset in tool frame
    # transformation: posx whose orientation is the rotation to apply about pivot
    set_tcp(tcp)
    base = get_current_posx()[0]
    px, py, pz = pivot[0], pivot[1], pivot[2]
    rz1, ry, rz2 = transformation[3], transformation[4], transformation[5]

    R = eul2rotm([rz1, ry, rz2])
    tx = px - (R[0][0]*px + R[0][1]*py + R[0][2]*pz)
    ty = py - (R[1][0]*px + R[1][1]*py + R[1][2]*pz)
    tz = pz - (R[2][0]*px + R[2][1]*py + R[2][2]*pz)
    delta = posx(tx, ty, tz, rz1, ry, rz2)
    final = trans(base, delta, DR_TOOL, DR_BASE)
    movel(final, time=5, ref=DR_BASE)
    set_tcp("Flange")
    tp_log("TCP set back to Flange")
    rotated_pos = get_current_posx()[0]
    tp_log("Current position: " + str(rotated_pos))
    return rotated_pos

# Stop Class
class ProcessAborted(Exception):
    pass
    
# Safe Move Function
def safe_movel(*args, **kwargs):
    status = get_modbus_slave(REG_STATUS)
    
    if status == 0:
        raise ProcessAborted()
        
    movel(*args, **kwargs)
    #tp_log("Status: " + str(status))
        
    if status == 0:
        raise ProcessAborted()

def check_emergency():
    if get_modbus_slave(REG_EMERGENCY) != 0:
        tp_log("Emergency triggered - stopping program")
        stop(DR_QSTOP)
        exit()
    wait(0.5)

thread_run(check_emergency, loop=True)
    
## Homing
if (homing_val):
    tp_log("Homing")
    x1, sol = current_pos = get_current_posx(ref=DR_WORLD)
    tp_log("Current Pos: " + str(x1))
    
    local_zones = [System_grinder_top,fkin(System_init_j), System_blades_top, System_grinder2_top]
    dist = [0] * 4
    #dist1 = get_distance(x1, System_grinder_top)
    #dist2 = get_distance(x1, fkin(System_init_j))
    #dist3 = get_distance(x1, System_blades_top)
    #dist4 = get_distance(x1, System_grinder2_top)
    
    for i in range(0,len(local_zones)):
        dist[i] = get_distance(x1, local_zones[i])
    
    closest_zone = dist.index(min(dist))
    while closest_zone != 2:
        tp_log("Closest_zone: " + str(closest_zone))
        if closest_zone == 0:
            movel(local_zones[0], 100, 20)
            closest_zone += 1
        elif closest_zone == 1:
            movej(System_init_j, 100, 20)
            closest_zone += 1
        elif closest_zone == 3:
            movel(local_zones[3], 100, 20)
            closest_zone -= 1
            
    tp_log("Going to blades now")        
    movel(local_zones[2], 100, 20)
    
else:
    tp_log("Skipped Homing")

    
