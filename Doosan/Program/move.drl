movej(System_blade1_j, 80, 50)
set_analog_output(ch=1, val=0.0)

set_ref_coord(DR_WORLD)

force_ext = get_tool_force(DR_TOOL)
current_z = force_ext[2]

fcon_z = check_force_condition(DR_AXIS_Z, min=max(current_z - 5,0), max=current_z + 2, ref=DR_TOOL)

amovel(posx([0,0,-50,0,0,0]), vel=10, acc=20,mod=DR_MV_MOD_REL)

while (fcon_z):
    fcon_z = check_force_condition(DR_AXIS_Z, min=max(current_z - 5,0), max=current_z + 2, ref=DR_TOOL)

stop(DR_SSTOP)

set_ref_coord(DR_WORLD)

pos1, sol = get_current_posx(DR_WORLD)

force_ext = get_tool_force(DR_WORLD)
current_y = force_ext[1]
tp_log("Current y: " + str(current_y))

#wait(5)

if (current_y < -2):
    max_current_y = -current_y
else:
    max_current_y = current_y + 10

tp_log("Max y:" + str(max_current_y))

fcon_y = check_force_condition(DR_AXIS_Y, min=max(current_y - 5,0), max=max_current_y, ref=DR_WORLD)
amovel(posx([0, -60, 0,0,0,0]), vel=10, acc=20, mod=DR_MV_MOD_REL)

while (fcon_y):
    force_ext = get_tool_force(DR_WORLD)
    tp_log("Y: " + str(force_ext[1]))
    fcon_y = check_force_condition(DR_AXIS_Y, min=max(current_y - 5,0), max=max_current_y, ref=DR_WORLD)

