    #dist3 = get_distance(x1, System_blades_top)
    #dist4 = get_distance(x1, System_grinder2_top)

    if (grinder_val == 1):
        target = 1
    elif (grinder_val == 2):
        target = 3
    else:
        tp_log("Default Grinder 1")
        target = 1
    
    for i in range(0,len(local_zones)):
        dist[i] = get_distance(x1, local_zones[i])
    
    closest_zone = dist.index(min(dist))
    
    loading_target = 1
    while closest_zone != loading_target:
        tp_log("Closest_zone: " + str(closest_zone))
        if closest_zone == 0:
            movel(local_zones[0], 100, 20)
            # closest_zone += 1
        elif closest_zone == 1:
            movej(System_init_j, 100, 20)
            # closest_zone += 1
        elif closest_zone == 2:
            movel(local_zones[2], 100, 20)
            # closest_zone -= 1
        elif closest_zone == 3:
            movel(local_zones[3], 100, 20)
            # closest_zone -= 1
        closest_zone += 1 if closest_zone < loading_target else -1
            
    tp_log("Going to loading now")        
    movej(System_init_j, time=5) 
    
    wait(5)

    if grinder_val == 1:
        loading_target = 0
    elif grinder_val == 2:
        loading_target = 3
    else:
        tp_log("Default Grinder 1")
        loading_target = 0

    while closest_zone != loading_target:
        tp_log("Closest_zone: " + str(closest_zone))
        if closest_zone == 0:
            movel(local_zones[0], 100, 20)
            # closest_zone += 1
        elif closest_zone == 1:
            movej(System_init_j, 100, 20)
            # closest_zone += 1
        elif closest_zone == 2:
            movel(local_zones[2], 100, 20)
            # closest_zone -= 1
        elif closest_zone == 3:
            movel(local_zones[3], 100, 20)
            # closest_zone -= 1
        closest_zone += 1 if closest_zone < loading_target else -1
    
else:
    tp_log("Skipped Loading")
       

